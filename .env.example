# Скопируйте в .env (локально) или задайте в панели хостинга (Render/Railway/...)
PORT=3000
# Длинный случайный ключ. Бот присылает его в заголовке x-api-key. Без ключа сервер открыт всем!
API_KEY=замените-на-длинный-случайный-ключ
# 1, если сервер стоит за прокси хостинга (Render, Railway, nginx) — для верного IP в лимите запросов
TRUST_PROXY=1
# Сколько карточек в минуту разрешено с одного IP
RATE_LIMIT_PER_MIN=60
# Хосты, с которых можно скачивать carImageUrl (через запятую). Пусто = скачивание отключено.
# Ссылки на картинки пака (…/img/sedan.png и т.п.) работают и без этого — берутся из ./assets.
ALLOWED_IMAGE_HOSTS=
# 0 — отключить GET /demo
DEMO=1
